---
import ReaderLayout from "../features/reader/layouts/ReaderLayout.astro";
---

<ReaderLayout>
  <div
    class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4"
  >
    <h1 class="text-6xl font-bold mb-4 text-[var(--color-link)]">404</h1>
    <h2 class="text-2xl font-semibold mb-6">Página no encontrada</h2>
    <p class="text-lg mb-8 max-w-md">
      Lo sentimos, la página que estás buscando no existe o ha sido movida.
    </p>
    <a
      href="/"
      class="px-6 py-3 rounded-lg bg-[var(--color-link)] text-[var(--color-bg)] font-medium hover:opacity-90 transition-opacity"
    >
      Volver al inicio
    </a>
  </div>
</ReaderLayout>
