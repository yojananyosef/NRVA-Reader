---
import ReaderLayout from '../features/reader/layouts/ReaderLayout.astro';
import Buscador from '../components/Buscador';
---

<ReaderLayout title="Concordancia Bíblica - Búsqueda Avanzada">
  <div class="w-full max-w-5xl mx-auto py-8 transition-colors">
    <div class="space-y-4 mb-10 text-center animate-fade-in-up">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-[var(--color-text)]">
          Concordancia <span class="text-[var(--color-link)] opacity-90">Inteligente</span>
        </h1>
        <p class="text-lg opacity-80 text-[var(--color-text)] max-w-2xl mx-auto">
          Explora miles de versículos al instante. La búsqueda es local, ultrarrápida y diseñada para el estudio profundo de las escrituras.
        </p>
      </div>
      
      <!-- Componente interactivo (Preact) -->
      <Buscador client:load />
    </div>
  </div>
</ReaderLayout>

<style>
  /* Animaciones útiles para el UI estilo Next.js */
  @keyframes fade-in-up {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fade-in {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
  .animate-fade-in {
    animation: fade-in 0.4s ease-out forwards;
  }
</style>
